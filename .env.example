# --- Server-side only (Supabase Edge Function secrets / local eval). Never expose to the browser. ---
ANTHROPIC_API_KEY=
# Optional, only if SearchProvider is switched off Claude web search
BRAVE_SEARCH_API_KEY=
PARALLEL_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=

# --- Provider selection (packages/core reads these) ---
LLM_PROVIDER=claude
EXTRACT_MODEL=claude-haiku-5-5
EXTRACT_FALLBACK_MODEL=claude-sonnet-5-5
WRITE_MODEL=claude-haiku-5-5
SEARCH_PROVIDER=claude

# --- Browser-safe (Vite exposes VITE_* only) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=
